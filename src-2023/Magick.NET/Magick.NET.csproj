<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Magick.NET</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
	  <PackageReference Include="Magick.NET.Core" Version="15.1.0" />
	</ItemGroup>

	<!-- Copy the files to the exe folder -->
	<ItemGroup>
		<None Update="*.jpg;*.tif;*.tiff" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>