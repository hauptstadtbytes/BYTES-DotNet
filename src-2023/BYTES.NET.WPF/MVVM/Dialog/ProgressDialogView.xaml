<Window x:Class="BYTES.NET.WPF.MVVM.Dialog.ProgressDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BYTES.NET.WPF.MVVM.Dialog"
        xmlns:converters="clr-namespace:BYTES.NET.WPF.Converters"
        xmlns:s="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding Title}" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- add the converters -->
        <converters:NothingToVisibilityConverter x:Key="NothingToVisibilityConverter"/>
        <!-- BooleanToVisibilityConverter is built-in, but if you don’t have it, define your own -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- see 'https://stackoverflow.com/questions/4997446/boolean-commandparameter-in-xaml' for details on using booleans in XAML-->
        <s:Boolean x:Key="True">True</s:Boolean>
        <s:Boolean x:Key="False">False</s:Boolean>
    </Window.Resources>

    <Grid Margin="5">

        <!-- setup the window structure -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition MaxHeight="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <!-- Message Block -->
            <TextBlock x:Name="MessageBlock" HorizontalAlignment="Stretch" Text="{Binding Message}" Margin="5" FontWeight="Bold"
               Visibility="{Binding ElementName=MessageBlock, Path=Text, Converter={StaticResource NothingToVisibilityConverter}, ConverterParameter={StaticResource False}}" />

            <!-- Progress Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                     Height="20" HorizontalAlignment="Stretch"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Value="{Binding ProgressValue, Mode=OneWay}"
                     Minimum="0" Maximum="100" />

                <Button Grid.Column="1" Content="Abbrechen" Margin="5" MinWidth="75"
                Visibility="{Binding AllowCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding Path=Commands[CancelCmd]}" />
            </Grid>

            <StackPanel Margin="5">
                <!-- Toggle Log Button -->
                <Button Content="Toggle Logs"
        Width="100" Height="25"
        ToolTip="Logs anzeigen/ausblenden"
        Command="{Binding Commands[ToggleLogCmd]}"
        Visibility="{Binding HasLogEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Logs TextBox -->
                <TextBox Text="{Binding LogText, Mode=OneWay}" 
         Margin="0,5,0,0"
         VerticalScrollBarVisibility="Auto"
         AcceptsReturn="True" 
         IsReadOnly="True"
         Height="150"
         Visibility="{Binding HasLogsAndExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
