<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PackageTest_System.Imaging</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<UseWPF>true</UseWPF>
  </PropertyGroup>

	<!-- Copy the files to the exe folder -->
	<ItemGroup>
		<None Update="*.jpg;*.tif;*.tiff" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
